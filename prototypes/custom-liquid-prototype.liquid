{% comment %}
  Это отдельная версия для быстрой проверки в Custom Liquid block неопубликованной темы.
  Здесь нет schema и обращения к настройкам section: параметры и парный URL намеренно захардкожены.
  Configurable section/snippet implementation хранится отдельно и подходит для интеграции
  после изучения структуры main product section конкретной темы.
{% endcomment %}

{%- liquid
  assign ef_proto_variant = product.selected_or_first_available_variant
  assign ef_proto_product_url = shop.url | append: product.url
  capture ef_proto_message
    echo 'Hola, tengo dudas sobre el lado o la medida de '
    echo product.title
    echo ': '
    echo ef_proto_product_url
    echo '. ¿Me ayudan a confirmar el modelo antes de comprar?'
  endcapture
-%}

<div class="ef-purchase-assist" data-ef-purchase-assist>
  <div class="ef-purchase-trust" aria-label="Pago, despacho y garantías">
    <p class="ef-purchase-trust__line">Hasta 6 cuotas sin interés · Envío gratis sobre $80.000 · 1 año por fallas de fabricación · 10 días de satisfacción según condiciones.</p>
  </div>

  <fieldset class="ef-side-switch">
    <legend class="ef-side-switch__legend">
      <span class="ef-side-switch__eyebrow">Elige el lado correcto</span>
      <span class="ef-side-switch__question">Mirando el sofá de frente, ¿dónde está el chaise longue?</span>
    </legend>

    <div class="ef-side-switch__options">
      <div class="ef-side-switch__card ef-side-switch__card--active" aria-current="true">
        <span class="ef-side-switch__label">Derecho</span>
        <svg class="ef-side-switch__diagram" viewBox="0 0 96 58" aria-hidden="true" focusable="false">
          <path d="M10 14h68a8 8 0 0 1 8 8v25a5 5 0 0 1-5 5H65a5 5 0 0 1-5-5V36H15a5 5 0 0 1-5-5V14Z" />
          <path d="M18 20v9h48v15h12V22H18Z" />
        </svg>
        <span class="ef-side-switch__status">Seleccionado</span>
      </div>

      <a
        class="ef-side-switch__card"
        href="https://eurofunda.cl/products/funda-de-sofa-esquinero-izquierdo-dark-chocolate"
        aria-label="Cambiar al lado Izquierdo"
      >
        <span class="ef-side-switch__label">Izquierdo</span>
        <svg class="ef-side-switch__diagram" viewBox="0 0 96 58" aria-hidden="true" focusable="false">
          <path d="M86 14H18a8 8 0 0 0-8 8v25a5 5 0 0 0 5 5h16a5 5 0 0 0 5-5V36h45a5 5 0 0 0 5-5V14Z" />
          <path d="M78 20v9H30v15H18V22h60Z" />
        </svg>
        <span class="ef-side-switch__status">Ver modelo</span>
      </a>
    </div>

    <p class="ef-side-switch__note">La orientación se define mirando el sofá de frente.</p>
  </fieldset>

  <aside class="ef-fit-assistant" aria-label="Ayuda antes de comprar">
    <p class="ef-fit-assistant__eyebrow">Ayuda antes de comprar</p>
    <h3 class="ef-fit-assistant__heading">¿Aún tienes dudas con la medida o el lado?</h3>
    <p class="ef-fit-assistant__body">Envíanos una foto de tu sofá por WhatsApp y te ayudamos a confirmar el modelo antes de comprar.</p>

    <ul class="ef-fit-assistant__measurements" aria-label="Rangos de medidas compatibles">
      <li class="ef-fit-assistant__measurement">Tramo principal: 180–370 cm</li>
      <li class="ef-fit-assistant__measurement">Chaise longue: 100–180 cm</li>
    </ul>

    <a
      class="ef-fit-assistant__cta"
      href="https://wa.me/56225830907?text={{ ef_proto_message | strip_newlines | strip | url_encode }}"
      target="_blank"
      rel="noopener"
      data-ef-fit-whatsapp
      data-product-id="{{ product.id }}"
      data-variant-id="{{ ef_proto_variant.id }}"
      data-product-handle="{{ product.handle | escape }}"
      data-placement="pdp_below_primary_cta"
    >
      Confirmar por WhatsApp
    </a>
  </aside>
</div>

<style>
  .ef-purchase-assist {
    --ef-ink: #1f211e;
    --ef-muted: #62675f;
    --ef-line: #d8d9d4;
    --ef-soft: #f5f4ef;
    --ef-accent: #26352b;
    --ef-focus: #075fcc;
    color: var(--ef-ink);
    font: inherit;
    margin-block: 1rem;
    max-width: 42rem;
  }

  .ef-purchase-trust {
    background: var(--ef-soft);
    border-radius: 0.625rem;
    color: var(--ef-muted);
    margin-block-end: 1.125rem;
    padding: 0.75rem 0.875rem;
  }

  .ef-purchase-trust__line {
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }

  .ef-side-switch {
    border: 0;
    margin: 0;
    min-inline-size: 0;
    padding: 0;
  }

  .ef-side-switch__legend {
    display: block;
    inline-size: 100%;
    margin-block-end: 0.75rem;
    padding: 0;
  }

  .ef-side-switch__eyebrow,
  .ef-fit-assistant__eyebrow {
    color: var(--ef-muted);
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    margin: 0 0 0.25rem;
    text-transform: uppercase;
  }

  .ef-side-switch__question {
    display: block;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .ef-side-switch__options {
    display: grid;
    gap: 0.625rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ef-side-switch__card {
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--ef-line);
    border-radius: 0.75rem;
    color: var(--ef-ink);
    display: grid;
    gap: 0.25rem;
    justify-items: center;
    min-height: 7.75rem;
    padding: 0.75rem;
    text-align: center;
    text-decoration: none;
  }

  .ef-side-switch__card--active {
    background: var(--ef-soft);
    border-color: var(--ef-accent);
    box-shadow: inset 0 0 0 1px var(--ef-accent);
  }

  .ef-side-switch__card:focus-visible,
  .ef-fit-assistant__cta:focus-visible {
    outline: 3px solid var(--ef-focus);
    outline-offset: 3px;
  }

  .ef-side-switch__label {
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .ef-side-switch__diagram {
    fill: none;
    height: 2.75rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    width: 4.75rem;
  }

  .ef-side-switch__status {
    color: var(--ef-muted);
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .ef-side-switch__note {
    color: var(--ef-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
    margin: 0.625rem 0 0;
  }

  .ef-fit-assistant {
    background: var(--ef-soft);
    border: 1px solid var(--ef-line);
    border-radius: 0.875rem;
    margin-block-start: 1.25rem;
    padding: 1rem;
  }

  .ef-fit-assistant__heading {
    font-size: 1.125rem;
    line-height: 1.35;
    margin: 0 0 0.5rem;
  }

  .ef-fit-assistant__body {
    color: var(--ef-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
  }

  .ef-fit-assistant__measurements {
    display: grid;
    gap: 0.25rem;
    list-style: none;
    margin: 0.75rem 0;
    padding: 0;
  }

  .ef-fit-assistant__measurement {
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .ef-fit-assistant__cta {
    align-items: center;
    background: transparent;
    border: 1px solid var(--ef-accent);
    border-radius: 0.5rem;
    color: var(--ef-accent);
    display: inline-flex;
    font-size: 0.9375rem;
    font-weight: 700;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    text-decoration: none;
  }

  .ef-fit-assistant__cta:hover {
    background: #e7e9e3;
  }

  @media (min-width: 48rem) {
    .ef-fit-assistant {
      padding: 1.125rem 1.25rem;
    }

    .ef-fit-assistant__measurements {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  (function () {
    if (window.__efFitAssistantClickBound) return;
    window.__efFitAssistantClickBound = true;

    document.addEventListener('click', function (event) {
      var origin = event.target;
      if (!origin || typeof origin.closest !== 'function') return;

      var link = origin.closest('[data-ef-fit-whatsapp]');
      if (!link) return;
      if (!window.Shopify || !Shopify.analytics || typeof Shopify.analytics.publish !== 'function') return;

      var published = Shopify.analytics.publish('eurofunda:fit_whatsapp_click', {
        product_id: link.dataset.productId,
        variant_id: link.dataset.variantId,
        product_handle: link.dataset.productHandle,
        placement: link.dataset.placement || 'pdp_below_primary_cta'
      });

      if (published && typeof published.catch === 'function') {
        published.catch(function () {});
      }
    });
  })();
</script>
