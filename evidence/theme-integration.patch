diff --git a/blocks/ef-purchase-assist.liquid b/blocks/ef-purchase-assist.liquid
new file mode 100644
index 0000000..d7185fc
--- /dev/null
+++ b/blocks/ef-purchase-assist.liquid
@@ -0,0 +1,49 @@
+{%- liquid
+  assign ef_right_handle = 'funda-de-sofa-esquinero-derecho-dark-chocolate'
+  assign ef_left_handle = 'funda-de-sofa-esquinero-izquierdo-dark-chocolate'
+  assign ef_current_side = blank
+  assign ef_opposite_url = blank
+
+  case product.handle
+    when ef_right_handle
+      assign ef_current_side = 'right'
+      assign ef_opposite_url = '/products/' | append: ef_left_handle | append: '?view=eurofunda-demo'
+    when ef_left_handle
+      assign ef_current_side = 'left'
+      assign ef_opposite_url = '/products/' | append: ef_right_handle | append: '?view=eurofunda-demo'
+  endcase
+-%}
+
+{%- if ef_current_side != blank -%}
+  <div class="ef-purchase-assist">
+    {% render 'ef-side-switch',
+      product: product,
+      current_side: ef_current_side,
+      opposite_url: ef_opposite_url,
+      right_label: 'Derecho',
+      left_label: 'Izquierdo',
+      placement: 'pdp_purchase_area'
+    %}
+
+    {% render 'ef-fit-assistant',
+      product: product,
+      whatsapp_number: '+56 2 2583 0907',
+      placement: 'pdp_below_primary_cta'
+    %}
+  </div>
+{%- elsif request.design_mode -%}
+  <!-- EF purchase assist is intentionally limited to the two demo product handles. -->
+{%- endif -%}
+
+{% schema %}
+{
+  "name": "EF purchase assist",
+  "tag": null,
+  "settings": [],
+  "presets": [
+    {
+      "name": "EF purchase assist"
+    }
+  ]
+}
+{% endschema %}
