{% comment %}
  Reusable composition for the standalone section and demonstrations.
  The primary theme integration renders trust near the price, then side switch and
  fit assistant after buy buttons; see docs/integration.md.
{% endcomment %}

{%- liquid
  assign ef_current_side = current_side | default: 'right'
  assign ef_show_trust = show_trust
  if ef_show_trust == nil
    assign ef_show_trust = true
  endif
-%}

{% render 'ef-purchase-assist-styles' %}

<div class="ef-purchase-assist" data-ef-purchase-assist>
  {%- if ef_show_trust -%}
    {% render 'ef-purchase-trust', trust_text: trust_text %}
  {%- endif -%}

  {% render 'ef-side-switch',
    product: product,
    current_side: ef_current_side,
    opposite_url: opposite_url,
    opposite_label: opposite_label,
    right_label: right_label,
    left_label: left_label,
    placement: 'pdp_purchase_area'
  %}

  {% render 'ef-fit-assistant',
    product: product,
    whatsapp_number: whatsapp_number,
    fit_heading: fit_heading,
    fit_body: fit_body,
    main_range: main_range,
    placement: 'pdp_below_primary_cta'
  %}
</div>
